tiny-name = Tiny
tiny-text = You are substantially smaller than average.
tiny-trait-cannot-pickup-weapon = You are too small to pick up { THE($item) }.
tiny-trait-cannot-attack-with-tool = You are too small to attack with { THE($item) }.
