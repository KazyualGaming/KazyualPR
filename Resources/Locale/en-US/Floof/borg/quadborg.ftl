borg-type-miningQuad-transponder = salvage cyborg

borg-type-medicalQuad-name = Medical
borg-type-medicalQuad-desc = Provide medical attention to crew who need it, either in medbay or in hazardous areas conventional paramedics cannot reach.
borg-type-medicalQuad-transponder = medical cyborg

borg-type-serviceQuad-name = Service
borg-type-serviceQuad-desc = Help out with a wide range of crew services, ranging from serving snacks and drinks to botany to entertainment.
borg-type-serviceQuad-transponder = service cyborg

